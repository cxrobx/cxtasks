{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CXTasks",
  "version": "0.1.0",
  "identifier": "com.cxtasks.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && bash scripts/build-helpers.sh"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "CXTasks",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/attachments/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/cxtasks-mcp",
      "binaries/cxtasks-runner"
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "Developer ID Application: Christopher Robinson (CCYV5HQZCM)"
    }
  }
}
